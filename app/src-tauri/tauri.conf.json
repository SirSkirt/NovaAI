{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neural Nova Experimental",
  "version": "0.12.5",
  "identifier": "com.qtech.neuralnova.experimental",
  "build": {
    "frontendDist": "../dist"
  },
  "plugins": {
    "background-service": {
      "androidForegroundServiceTypes": ["specialUse"],
      "androidValidateForegroundServiceType": true,
      "androidShowStopAction": false
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Neural Nova — Brain Lab",
        "width": 1280,
        "height": 880,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
